# =============================================================================
# RAG Chat Backend - Environment Variables Template
# =============================================================================
#
# INSTRUCTIONS:
# 1. Copy this file to .env: cp .env.example .env
# 2. Fill in your actual API keys below
# 3. NEVER commit .env to git (it's in .gitignore)
#
# =============================================================================

# -----------------------------------------------------------------------------
# OpenAI Configuration
# -----------------------------------------------------------------------------
# Get your API key from: https://platform.openai.com/api-keys
# Required for: Chat completions and text embeddings
OPENAI_API_KEY=sk-your-openai-api-key-here

# -----------------------------------------------------------------------------
# Pinecone Configuration
# -----------------------------------------------------------------------------
# Get your API key from: https://app.pinecone.io/
# Required for: Vector database storage and semantic search
PINECONE_API_KEY=your-pinecone-api-key-here

# -----------------------------------------------------------------------------
# Supabase Configuration
# -----------------------------------------------------------------------------
# Get your credentials from: https://supabase.com/dashboard/project/_/settings/api
# Required for: User data, chat history, book metadata storage
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-key-here

# -----------------------------------------------------------------------------
# Optional: Application Configuration
# -----------------------------------------------------------------------------
# Uncomment and modify if needed

# Application environment (development, staging, production)
# APP_ENV=development

# API host and port
# API_HOST=0.0.0.0
# API_PORT=8000

# CORS origins (comma-separated for production)
# CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Optional: Model Configuration
# -----------------------------------------------------------------------------
# Uncomment to use different OpenAI models

# Chat model (default: gpt-3.5-turbo)
# OPENAI_CHAT_MODEL=gpt-3.5-turbo

# Embedding model (default: text-embedding-ada-002)
# OPENAI_EMBEDDING_MODEL=text-embedding-ada-002

# -----------------------------------------------------------------------------
# Optional: RAG Configuration
# -----------------------------------------------------------------------------
# Uncomment to customize chunking and retrieval

# Default chunk size in words
# DEFAULT_CHUNK_SIZE=500

# Default overlap size in words
# DEFAULT_OVERLAP_SIZE=50

# Number of similar chunks to retrieve
# DEFAULT_TOP_K=3

# =============================================================================
# SECURITY REMINDERS:
# - Never share your .env file
# - Never commit .env to version control
# - Rotate API keys if accidentally exposed
# - Use different keys for development and production
# =============================================================================
